# Copy to `.env.local` (gitignored) before running.
# All values below are placeholders — nothing is wired up yet.

# ── Supabase (Phase 3 — not yet integrated) ────────────────────────────────
# Create a project at https://supabase.com, then paste the URL + anon key here.
# The service-role key must NEVER ship to the browser — server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Phase 4 — AI matching, not yet integrated) ──────────────────
# Get a key at https://console.anthropic.com — server-side only.
ANTHROPIC_API_KEY=
